FROM ros:noetic-ros-base-focal

ARG TARGETPLATFORM
ARG TARGETARCH

LABEL org.opencontainers.image.title="scan_planner ROS Noetic builder"

ENV DEBIAN_FRONTEND=noninteractive

RUN if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|http://ports.ubuntu.com/ubuntu-ports|http://mirrors.ustc.edu.cn/ubuntu-ports|g' /etc/apt/sources.list; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config file \
    libeigen3-dev \
    libboost-thread-dev libboost-system-dev libboost-chrono-dev \
    libboost-filesystem-dev libboost-iostreams-dev libboost-program-options-dev libboost-serialization-dev \
    libarmadillo-dev \
    libjsoncpp-dev \
    libmosquitto-dev \
    ros-noetic-pcl-ros ros-noetic-pcl-conversions \
    ros-noetic-cv-bridge \
    ros-noetic-tf ros-noetic-tf2 ros-noetic-tf2-ros \
    ros-noetic-visualization-msgs \
    ros-noetic-nav-msgs ros-noetic-sensor-msgs \
    ros-noetic-geometry-msgs ros-noetic-std-msgs \
    ros-noetic-message-generation ros-noetic-message-runtime \
    ros-noetic-cmake-modules \
    ros-noetic-message-filters \
 && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends ccache \
 && rm -rf /var/lib/apt/lists/*

RUN echo "Built for TARGETPLATFORM=${TARGETPLATFORM:-unknown} TARGETARCH=${TARGETARCH:-unknown}" \
 && uname -m

WORKDIR /ws
CMD ["bash"]
