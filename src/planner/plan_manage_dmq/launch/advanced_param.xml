<launch>
  <arg name="is_real_world"/>
  <arg name="navi_mode"/>
  <arg name="sensor_type"/>
  <arg name="body_pose_topic"/>
  <arg name="sensor_pose_topic"/>
  <arg name="cloud_topic"/>
  <arg name="cloud_is_world"/>
  <arg name="need_extrinsic" default="$(arg is_real_world)"/>
  <arg name="config_file" default=""/>
  <arg name="depth_topic"/>
  <arg name="cx"/>
  <arg name="cy"/>
  <arg name="fx"/>
  <arg name="fy"/>

  <!-- public parameters -->
  <arg name="scan_max_vel" default="0.22"/>
  <arg name="max_acc" default="0.5"/>
  <arg name="planning_horizon" default="7.5"/>
  <arg name="max_replan_fail_count" default="12"/>

  <!-- main node -->
  <!-- respawn: scan_planner_dmq_node owns the SCAN FSM. If it dies
       (OOM-kill, uncaught exception, etc.) while the robot is in
       LOCAL_AVOID, the takeover handshake with navdog_runtime can never
       complete and the robot stays permanently stopped after recovery is
       exhausted. roslaunch respawn keeps the process supervised so the
       existing deferred takeover-sync logic (see
       SCANReplanFSM::takeoverSyncCallback/execFSMCallback) can resume the
       handoff once the node restarts. -->
  <node pkg="scan_planner_dmq" name="scan_planner_dmq_node" type="scan_planner_dmq_node"
        output="screen" clear_params="true" respawn="true" respawn_delay="1.0">
    <remap from="/grid_map/body_pose" to="$(arg body_pose_topic)"/>
    <remap from="/grid_map/sensor_pose" to="$(arg sensor_pose_topic)"/>
    <param name="grid_map/sensor_type" value="$(arg sensor_type)" type="str"/>
    <remap from="/grid_map/cloud" to="$(arg cloud_topic)"/>
    <param name="grid_map/cloud_is_world" value="$(arg cloud_is_world)"/>
    <remap from="/grid_map/depth" to="$(arg depth_topic)"/>
    <param name="grid_map/need_extrinsic" value="$(arg need_extrinsic)" type="bool"/>

    <!-- planning fsm -->
    <param name="fsm/navi_mode" value="$(arg navi_mode)" type="int"/>
    <param name="fsm/thresh_replan" value="0.20" type="double"/>
    <param name="fsm/thresh_no_replan" value="0.20" type="double"/>
    <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <param name="fsm/emergency_time_" value="1.0" type="double"/>
    <param name="fsm/fail_safe" value="true" type="bool"/>

    <param name="fsm/max_replan_fail_count"
          value="$(arg max_replan_fail_count)"
          type="int"/>

    <!-- 1秒内存在轨迹碰撞时，绕过冷却并立即重规划。 -->
    <param name="fsm/safety_immediate_replan_sec"
          value="1.0"
          type="double"/>

    <!-- 1～3秒内存在轨迹碰撞时，直接尝试重规划。 -->
    <param name="fsm/safety_direct_replan_sec"
          value="3.0"
          type="double"/>

    <!-- 非紧急安全重规划的最短间隔，避免20Hz安全检查引发规划风暴。 -->
    <param name="fsm/safety_replan_cooldown_sec"
          value="0.15"
          type="double"/>

    <param name="fsm/nominal_replan_period_sec" value="0.20" type="double"/>
    <param name="fsm/min_replan_progress_m" value="0.05" type="double"/>
    <param name="fsm/replan_retry_interval_sec" value="0.10" type="double"/>
    <param name="fsm/replan_lead_time_sec" value="0.40" type="double"/>

    <param name="fsm/emergency_retry_interval_sec"
          value="0.50"
          type="double"/>

    <param name="fsm/is_real_world"
          value="$(arg is_real_world)"
          type="bool"/>

    <remap from="/initial_path" to="/native_scan/initial_path"/>

    <!-- sliding map -->
    <param name="grid_map/resolution" value="0.05"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/sliding_map_size_x" value="10.0"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/sliding_map_size_y" value="10.0"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/sliding_map_size_z" value="5.0"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/map_sliding_thresh" value="0.2"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/double_cylinder_radius" value="0.25"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/double_cylinder_offset" value="0.18"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/body_height" value="0.30" type="double"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/obstacles_inflation_z_up" value="0.1"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/obstacles_inflation_z_down" value="0.4"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/stair_support_clearance_m" value="0.20"
           if="$(eval arg('config_file') == '')"/>

    <!-- depth camera intrinsics -->
    <param name="grid_map/cx" value="$(arg cx)"/>
    <param name="grid_map/cy" value="$(arg cy)"/>
    <param name="grid_map/fx" value="$(arg fx)"/>
    <param name="grid_map/fy" value="$(arg fy)"/>

    <!-- depth -->
    <param name="grid_map/depth_filter_maxdist"   value="3.0"/>
    <param name="grid_map/depth_filter_mindist"   value="0.3"/>
    <param name="grid_map/depth_filter_margin"    value="1"/>
    <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
    <param name="grid_map/skip_pixel" value="2"/>

    <!-- local fusion -->
    <param name="grid_map/p_hit" value="0.85"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/p_miss" value="0.30"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/p_min" value="0.12"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/p_max" value="0.98"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/p_occ" value="0.80"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/max_ray_length" value="5.0"
           if="$(eval arg('config_file') == '')"/>
    <!-- Occupancy fusion stays on SCAN's single callback queue so planner/map
         access remains serialized. The real-device YAML may use a slower
         period when dense lidar frames cannot finish inside 50ms. -->
    <param name="grid_map/occupancy_update_interval_sec" value="0.05"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/visualization_update_interval_sec" value="0.05"
           if="$(eval arg('config_file') == '')"/>
    <!-- Hard cap on how many projected lidar points are integrated per
         occupancy update cycle.
         Dense indoor scans can carry tens of thousands of unique occupied
         voxels even after per-voxel dedup, and the walk cost can exceed the
         timer period by 2-3x, starving the FSM/odom/SCAN-takeover callbacks
         on the same single-threaded ros::spin(). When capped, points are
         selected evenly across the ordered frame and each selected point
         performs both its endpoint and free-space update, preventing stale
         hits from accumulating without their corresponding clearing rays.
         <= 0 disables the cap. -->
    <param name="grid_map/max_raycast_walk_points" value="15000"
           if="$(eval arg('config_file') == '')"/>
    <param name="grid_map/vis_height" value="0.3" type="double"
           if="$(eval arg('config_file') == '')"/>

    <!-- planner manager -->
    <param name="manager/max_vel" value="$(arg scan_max_vel)" type="double"/>
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="manager/max_jerk" value="4" type="double"/>
    <param name="manager/control_points_distance" value="0.2" type="double"/>
    <param name="manager/feasibility_tolerance" value="0.5" type="double"/>
    <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>

    <!-- trajectory optimization -->
    <param name="optimization/lambda_smooth" value="1.0" type="double"/>
    <param name="optimization/lambda_collision" value="1.0" type="double"/>
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <param name="optimization/dist0" value="0.2" type="double"/>
    <param name="optimization/max_vel" value="$(arg scan_max_vel)" type="double"/>
    <param name="optimization/vel_tolerance" value="1.0" type="double"/>
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="optimization/acc_tolerance" value="1.0" type="double"/>

    <rosparam command="load" file="$(arg config_file)"
              if="$(eval arg('config_file') != '')"/>

  </node>

  <!-- trajectory tracking -->
  <param name="closed_loop_controller/time_forward" value="0.8" type="double"/>
  <param name="closed_loop_controller/kp_pos" value="0.8" type="double"/>
  <param name="closed_loop_controller/kp_yaw" value="1.5" type="double"/>
  <param name="closed_loop_controller/max_vx" value="$(arg scan_max_vel)" type="double"/>
  <param name="closed_loop_controller/max_vy" value="0.18" type="double"/>
  <param name="closed_loop_controller/max_vyaw" value="0.65" type="double"/>
  <param name="closed_loop_controller/finish_dist" value="0.15" type="double"/>
  <param name="closed_loop_controller/mode_transition_duration_sec" value="0.5" type="double"/>

</launch>
